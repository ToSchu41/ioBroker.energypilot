{
  "i18n": true,
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "Central settings",
      "items": {
        "_h1": {
          "type": "header",
          "text": "Energy management",
          "size": 4,
          "sm": 12
        },
        "emsEnabled": {
          "type": "checkbox",
          "label": "Enable Energy Pilot",
          "sm": 6
        },
        "dryRun": {
          "type": "checkbox",
          "label": "Dry run (calculate only, do not write commands)",
          "sm": 6
        },
        "cycleSec": {
          "type": "number",
          "label": "Control interval (s)",
          "sm": 6,
          "default": 5,
          "min": 1,
          "max": 60
        },
        "staleSec": {
          "type": "number",
          "label": "State timeout (s)",
          "sm": 6,
          "default": 30,
          "min": 5,
          "max": 600
        },
        "targetGridW": {
          "type": "number",
          "label": "Target grid power (W)",
          "sm": 6,
          "default": 0
        },
        "gridReserveW": {
          "type": "number",
          "label": "Grid reserve / deadband (W)",
          "sm": 6,
          "default": 200,
          "min": 0
        },
        "allocationStrategy": {
          "type": "select",
          "label": "Allocation strategy",
          "options": [
            {
              "label": "Strict priority",
              "value": "priority"
            },
            {
              "label": "Minimum demand first",
              "value": "minimum"
            }
          ],
          "sm": 6
        },
        "_h2": {
          "type": "header",
          "text": "Consumption forecast",
          "size": 4,
          "sm": 12
        },
        "baseDailyConsumptionKWh": {
          "type": "number",
          "label": "Base daily consumption (kWh)",
          "sm": 6,
          "default": 8,
          "min": 0
        },
        "heatingBalanceTempC": {
          "type": "number",
          "label": "Heating balance temperature (\u00b0C)",
          "sm": 6,
          "default": 15
        },
        "heatingKWhPerK": {
          "type": "number",
          "label": "Heating demand (kWh per K/day)",
          "sm": 6,
          "default": 1.2,
          "min": 0,
          "step": 0.1
        },
        "coolingBalanceTempC": {
          "type": "number",
          "label": "Cooling balance temperature (\u00b0C)",
          "sm": 6,
          "default": 24
        },
        "coolingKWhPerK": {
          "type": "number",
          "label": "Cooling demand (kWh per K/day)",
          "sm": 6,
          "default": 0.7,
          "min": 0,
          "step": 0.1
        },
        "learningEnabled": {
          "type": "checkbox",
          "label": "Use learned historical baseline",
          "sm": 6
        },
        "historyDays": {
          "type": "number",
          "label": "Learning window (days)",
          "sm": 6,
          "default": 30,
          "min": 7,
          "max": 365
        },
        "_i": {
          "type": "staticText",
          "text": "Safety and device protection remain in the controlled devices. Energy Pilot provides only energy-optimization setpoints and releases.",
          "sm": 12
        }
      }
    },
