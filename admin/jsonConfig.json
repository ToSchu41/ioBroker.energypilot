    "diagnostics": {
      "type": "panel",
      "label": "Diagnostics",
      "items": {
        "_h": {
          "type": "header",
          "text": "Live diagnostic states",
          "size": 4,
          "sm": 12
        },
        "_i": {
          "type": "staticText",
          "text": "After saving and starting the instance, open the Objects tab under energypilot.<instance>.diagnostics. There you can see data validity, current power balance, forecast values, priorities, commands and decision reasons.",
          "sm": 12
        },
        "_dry": {
          "type": "staticText",
          "text": "Recommendation for commissioning: keep Dry run enabled first and verify all interpreted values and signs before enabling write commands.",
          "sm": 12
