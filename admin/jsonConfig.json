        },
        "gridReserveW": {
          "type": "number",
          "label": "Grid reserve / deadband (W)",
          "sm": 6,
          "default": 200,
          "min": 0
        },
        "_i2": {
          "type": "staticText",
          "text": "V0.1 allocates current measured surplus by priority and uses hysteresis/delays for thermal loads. Future versions can extend this with weighted/proportional allocation without changing device mappings.",
          "sm": 12
        }
      }
