{
  "i18n": true,
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "Zentrale Einstellungen",
      "items": {
        "_h0": {
          "type": "header",
          "text": "Betrieb",
          "size": 4,
          "sm": 12
        },
        "_i0": {
          "type": "staticText",
          "text": "Hier werden nur anlagenweite Einstellungen vorgenommen. Gerätespezifische Werte befinden sich in den jeweiligen Gerätebereichen.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "emsEnabled": {
          "type": "checkbox",
          "label": "Energy Pilot aktivieren",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "dryRun": {
          "type": "checkbox",
          "label": "Testbetrieb – nur berechnen, keine Stellwerte schreiben",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "help": "Für die Erstinbetriebnahme empfohlen."
        },
        "cycleSec": {
          "type": "number",
          "label": "Regelintervall",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 5,
          "help": "Zeit zwischen zwei Regelzyklen.",
          "min": 1,
          "max": 60,
          "unit": "s"
        },
        "staleSec": {
          "type": "number",
          "label": "Timeout für Eingangsdaten",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 30,
          "help": "Messwerte, die älter sind, gelten als ungültig.",
          "min": 5,
          "max": 600,
          "unit": "s"
        },
        "_d1": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h1": {
          "type": "header",
          "text": "Netzregelung",
          "size": 4,
          "sm": 12
        },
        "targetGridW": {
          "type": "number",
          "label": "Zielwert Netzleistung",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 0,
          "help": "Positiv bedeutet intern Netzbezug, negativ Einspeisung.",
          "unit": "W"
        },
        "gridReserveW": {
          "type": "number",
          "label": "Netzreserve / Totband",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 200,
          "help": "Kleine Schwankungen innerhalb dieses Bereichs lösen keine zusätzliche Lastzuteilung aus.",
          "min": 0,
          "unit": "W"
        },
        "allocationStrategy": {
          "type": "select",
          "label": "Verteilungsstrategie",
          "options": [
            {
              "label": "Strikte Priorität",
              "value": "priority"
            },
            {
              "label": "Mindestbedarf zuerst",
              "value": "minimum"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "priority"
        },
        "_d2": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h2": {
          "type": "header",
          "text": "Verbrauchsprognose",
          "size": 4,
          "sm": 12
        },
        "_i2": {
          "type": "staticText",
          "text": "Diese Werte bilden den Startpunkt für die Verbrauchsprognose. Wetterdaten und – sofern aktiviert – gelernte historische Verbräuche verfeinern die Prognose.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "baseDailyConsumptionKWh": {
          "type": "number",
          "label": "Grundverbrauch pro Tag",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 8,
          "help": "Basisverbrauch ohne temperaturabhängigen Heiz- oder Kühlbedarf.",
          "min": 0,
          "unit": "kWh"
        },
        "heatingBalanceTempC": {
          "type": "number",
          "label": "Heizgrenztemperatur",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 15,
          "unit": "°C"
        },
        "heatingKWhPerK": {
          "type": "number",
          "label": "Zusätzlicher Heizbedarf je Kelvin und Tag",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 1.2,
          "help": "Nur verwendet, solange kein ausreichend passendes Lernprofil vorhanden ist.",
          "min": 0,
          "step": 0.1,
          "unit": "kWh/K"
        },
        "coolingBalanceTempC": {
          "type": "number",
          "label": "Kühlgrenztemperatur",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 24,
          "unit": "°C"
        },
        "coolingKWhPerK": {
          "type": "number",
          "label": "Zusätzlicher Kühlbedarf je Kelvin und Tag",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 0.7,
          "help": "Nur verwendet, solange kein ausreichend passendes Lernprofil vorhanden ist.",
          "min": 0,
          "step": 0.1,
          "unit": "kWh/K"
        },
        "learningEnabled": {
          "type": "checkbox",
          "label": "Historischen Verbrauch lernen und verwenden",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "historyDays": {
          "type": "number",
          "label": "Lernzeitraum",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 30,
          "help": "Optional – Anzahl der zurückliegenden Tage für Vergleichswerte.",
          "min": 7,
          "max": 365,
          "unit": "Tage"
        },
        "_d3": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_note": {
          "type": "staticText",
          "text": "Sicherheits- und Geräteschutzfunktionen verbleiben vollständig in den angesteuerten Geräten. Energy Pilot optimiert ausschließlich Sollwerte und Freigaben.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        }
      }
    },
    "pvStorage": {
      "type": "panel",
      "label": "PV & Batteriespeicher",
      "items": {
        "_h0": {
          "type": "header",
          "text": "Netzanschluss / zentraler Energiemeter",
          "size": 4,
          "sm": 12
        },
        "_i0": {
          "type": "staticText",
          "text": "Pflichtwerte zuerst: Für die Grundregelung werden Netzleistung und PV-Leistung benötigt. Alle als „Optional“ gekennzeichneten Felder können leer bleiben.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "gridPowerState": {
          "type": "objectId",
          "label": "Wirkleistung am Netzanschluss – erforderlich",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um."
        },
        "gridSign": {
          "type": "select",
          "label": "Vorzeichen der Netzleistung",
          "options": [
            {
              "label": "Positiv = Netzbezug",
              "value": "importPositive"
            },
            {
              "label": "Positiv = Einspeisung",
              "value": "exportPositive"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "importPositive"
        },
        "housePowerState": {
          "type": "objectId",
          "label": "Hausverbrauch – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – falls kein eigener Hausverbrauchsdatenpunkt vorhanden ist, wird er aus PV, Netz und Batterie abgeleitet. Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um."
        },
        "_d1": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h1": {
          "type": "header",
          "text": "PV-Wechselrichter",
          "size": 4,
          "sm": 12
        },
        "pvPowerState": {
          "type": "objectId",
          "label": "Aktuelle PV-Leistung – erforderlich",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um."
        },
        "_d2": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h2": {
          "type": "header",
          "text": "Batteriespeicher – Grunddaten",
          "size": 4,
          "sm": 12
        },
        "batteryEnabled": {
          "type": "checkbox",
          "label": "Batteriespeicher verwenden",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "batteryName": {
          "type": "text",
          "label": "Bezeichnung",
          "sm": 12,
          "md": 6,
          "lg": 6,
          "default": "Batteriespeicher",
          "hidden": "!data.batteryEnabled"
        },
        "batteryPriority": {
          "type": "number",
          "label": "Ladepriorität",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 30,
          "help": "Kleinere Zahl = höhere Priorität.",
          "min": 1,
          "max": 100,
          "hidden": "!data.batteryEnabled"
        },
        "batterySocState": {
          "type": "objectId",
          "label": "Ladezustand / SOC – erforderlich bei aktivem Speicher",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Erwartete Einheit: %.",
          "hidden": "!data.batteryEnabled"
        },
        "batteryPowerState": {
          "type": "objectId",
          "label": "Vom Batteriesystem gemeldete Leistung – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um.",
          "hidden": "!data.batteryEnabled || data.batteryMeasurementMode !== 'device'"
        },
        "batteryPowerSign": {
          "type": "select",
          "label": "Vorzeichen der Batterieleistung",
          "options": [
            {
              "label": "Positiv = Laden",
              "value": "chargePositive"
            },
            {
              "label": "Positiv = Entladen",
              "value": "dischargePositive"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "chargePositive",
          "hidden": "!data.batteryEnabled || (data.batteryMeasurementMode !== 'device' && data.batteryMeasurementMode !== 'meter')"
        },
        "_d3": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h3": {
          "type": "header",
          "text": "Batterie – Energiemessung",
          "size": 4,
          "sm": 12
        },
        "batteryMeasurementMode": {
          "type": "select",
          "label": "Quelle der Leistungsmessung",
          "options": [
            {
              "label": "Keine Messung",
              "value": "none"
            },
            {
              "label": "Vom Gerät gemeldet",
              "value": "device"
            },
            {
              "label": "Externer Energiemeter",
              "value": "meter"
            },
            {
              "label": "Geschätzter Wert",
              "value": "estimated"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "device",
          "help": "Optional – externe Energiemeter können jederzeit später ergänzt werden.",
          "hidden": "!data.batteryEnabled"
        },
        "batteryMeterPowerState": {
          "type": "objectId",
          "label": "Externer Batterie-Energiemeter – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um.",
          "hidden": "!data.batteryEnabled || data.batteryMeasurementMode !== 'meter'"
        },
        "_d4": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h4": {
          "type": "header",
          "text": "Batteriesteuerung",
          "size": 4,
          "sm": 12
        },
        "batteryChargeControlEnabled": {
          "type": "checkbox",
          "label": "Externe Lade-/Entladesteuerung verwenden",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "help": "Nur aktivieren, wenn der Wechselrichter bzw. das Batteriesystem externe Vorgaben unterstützt.",
          "hidden": "!data.batteryEnabled"
        },
        "batteryChargeControlType": {
          "type": "select",
          "label": "Art des Sollwertes",
          "options": [
            {
              "label": "Leistung",
              "value": "power"
            },
            {
              "label": "Strom",
              "value": "current"
            },
            {
              "label": "Prozent",
              "value": "percent"
            },
            {
              "label": "Ein/Aus",
              "value": "boolean"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "power",
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled"
        },
        "batteryChargeSetState": {
          "type": "objectId",
          "label": "Datenpunkt Ladebegrenzung / Ladesollwert – erforderlich",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Die erwartete Einheit hängt von der gewählten Steuerart ab.",
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled"
        },
        "batteryDischargeSetState": {
          "type": "objectId",
          "label": "Datenpunkt Entladebegrenzung / Entladesollwert – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – kann leer bleiben, wenn das System nur die Ladebegrenzung unterstützt.",
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled"
        },
        "batteryVoltageState": {
          "type": "objectId",
          "label": "Batteriespannung – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – nur für eine Umrechnung von Leistung in Strom sinnvoll bzw. notwendig.",
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled || data.batteryChargeControlType !== 'current'"
        },
        "batteryMaxChargeValue": {
          "type": "number",
          "label": "Maximaler Lade-Sollwert",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 5000,
          "help": "Einheit passend zur gewählten Steuerart.",
          "min": 0,
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled"
        },
        "batteryMaxDischargeValue": {
          "type": "number",
          "label": "Maximaler Entlade-Sollwert",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 5000,
          "help": "Optional – nur relevant, wenn ein Entladesollwert geschrieben werden kann.",
          "min": 0,
          "hidden": "!data.batteryEnabled || !data.batteryChargeControlEnabled"
        },
        "_d5": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h5": {
          "type": "header",
          "text": "SOC-Grenzen & Prognoseoptimierung",
          "size": 4,
          "sm": 12
        },
        "batteryMinSoc": {
          "type": "number",
          "label": "Minimaler SOC",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 10,
          "min": 0,
          "max": 100,
          "unit": "%",
          "hidden": "!data.batteryEnabled"
        },
        "batteryReserveSoc": {
          "type": "number",
          "label": "Reserve-SOC",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 20,
          "help": "Unterhalb dieser Reserve wird Energy Pilot keine zusätzliche Entladung anfordern.",
          "min": 0,
          "max": 100,
          "unit": "%",
          "hidden": "!data.batteryEnabled"
        },
        "batteryTargetSoc": {
          "type": "number",
          "label": "Ziel-SOC",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 80,
          "help": "Ziel für die prognosebasierte Ladeplanung.",
          "min": 0,
          "max": 100,
          "unit": "%",
          "hidden": "!data.batteryEnabled"
        },
        "batteryMaxSoc": {
          "type": "number",
          "label": "Maximaler SOC",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": 100,
          "min": 0,
          "max": 100,
          "unit": "%",
          "hidden": "!data.batteryEnabled"
        },
        "batteryForecastControl": {
          "type": "checkbox",
          "label": "PV- und Verbrauchsprognose bei der Batterieladung berücksichtigen",
          "sm": 12,
          "md": 6,
          "lg": 4,
          "hidden": "!data.batteryEnabled"
        }
      }
    },
    "forecast": {
      "type": "panel",
      "label": "Wetter & Prognosen",
      "items": {
        "_h0": {
          "type": "header",
          "text": "PV-Prognose",
          "size": 4,
          "sm": 12
        },
        "_i0": {
          "type": "staticText",
          "text": "Energy Pilot verwendet vorhandene ioBroker-Prognosedaten. Die Einheiten der verknüpften Objekte werden automatisch erkannt und normalisiert.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "forecastEnabled": {
          "type": "checkbox",
          "label": "Prognosen verwenden",
          "sm": 12,
          "md": 6,
          "lg": 4
        },
        "pvForecastTodayState": {
          "type": "objectId",
          "label": "PV-Energie heute – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – empfohlen. Erwartet wird eine Energiemenge. Energy Pilot liest die Einheit automatisch und rechnet Wh/kWh/MWh intern in kWh um.",
          "hidden": "!data.forecastEnabled"
        },
        "pvForecastRemainingState": {
          "type": "objectId",
          "label": "PV-Energie Rest des Tages – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – besonders wichtig für die Speicherplanung. Erwartet wird eine Energiemenge. Energy Pilot liest die Einheit automatisch und rechnet Wh/kWh/MWh intern in kWh um.",
          "hidden": "!data.forecastEnabled"
        },
        "pvForecastTomorrowState": {
          "type": "objectId",
          "label": "PV-Energie morgen – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – ermöglicht eine vorausschauende Entlade-/Reserveplanung. Erwartet wird eine Energiemenge. Energy Pilot liest die Einheit automatisch und rechnet Wh/kWh/MWh intern in kWh um.",
          "hidden": "!data.forecastEnabled"
        },
        "pvForecastPowerNowState": {
          "type": "objectId",
          "label": "PV-Leistungsprognose aktuell – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional. Erwartet wird eine Leistung. Energy Pilot liest die Einheit des gewählten Objekts automatisch und rechnet W/kW/MW intern in W um.",
          "hidden": "!data.forecastEnabled"
        },
        "pvForecastInstalledState": {
          "type": "objectId",
          "label": "Installierte PV-Leistung – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – erwartet W/kW/kWp; dient vorerst der Diagnose und Plausibilisierung.",
          "hidden": "!data.forecastEnabled"
        },
        "pvForecastNext3hState": {
          "type": "objectId",
          "label": "PV-Energie nächste 3 Stunden – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Optional – nur verwenden, wenn der Forecast-Adapter diesen Summenwert direkt bereitstellt. Erwartet wird eine Energiemenge. Energy Pilot liest die Einheit automatisch und rechnet Wh/kWh/MWh intern in kWh um.",
          "hidden": "!data.forecastEnabled"
        },
        "_d1": {
          "type": "divider",
          "sm": 12,
          "height": 24
        },
        "_h1": {
          "type": "header",
          "text": "Wetterprognose",
          "size": 4,
          "sm": 12
        },
        "_i1": {
          "type": "staticText",
          "text": "Für ioBroker „dasWetter“ kann Energy Pilot den kompletten 24-Stunden-Forecast des aktuellen Tages selbst auslesen. Laut offizieller Adapterstruktur stehen dafür stündliche Forecastdaten bereit.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "weatherSourceMode": {
          "type": "select",
          "label": "Wetterquelle",
          "options": [
            {
              "label": "Automatisch aus ioBroker dasWetter",
              "value": "daswetter"
            },
            {
              "label": "Manuelle Datenpunktzuordnung",
              "value": "manual"
            },
            {
              "label": "Keine Wetterprognose",
              "value": "none"
            }
          ],
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": "daswetter",
          "hidden": "!data.forecastEnabled"
        },
        "dasWetterBasePath": {
          "type": "text",
          "label": "Basispfad der dasWetter-Instanz",
          "sm": 12,
          "md": 6,
          "lg": 6,
          "default": "daswetter.0",
          "help": "Nur der Instanzpfad ist nötig. Energy Pilot sucht darunter ForecastHourly automatisch.",
          "hidden": "!data.forecastEnabled || data.weatherSourceMode !== 'daswetter'"
        },
        "dasWetterLocation": {
          "type": "text",
          "label": "Standortkanal",
          "default": "Location_1",
          "sm": 12,
          "md": 6,
          "lg": 6,
          "help": "In der Regel Location_1. Nur ändern, wenn die dasWetter-Instanz einen anderen Standortkanal verwendet.",
          "hidden": "!data.forecastEnabled || data.weatherSourceMode !== 'daswetter'"
        },
        "_dasNote": {
          "type": "staticText",
          "text": "Automatisch ausgewertet werden Temperatur, Bewölkung, Luftfeuchtigkeit, Wind und Niederschlagswahrscheinlichkeit über die verfügbaren Stunden des Tages.",
          "sm": 12,
          "style": {
            "marginBottom": "12px"
          }
        },
        "weatherTempNowState": {
          "type": "objectId",
          "label": "Aktuelle Außentemperatur – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Nur bei manueller Wetterquelle. Erwartete Einheit: °C.",
          "hidden": "!data.forecastEnabled || data.weatherSourceMode !== 'manual'"
        },
        "weatherTempAvgState": {
          "type": "objectId",
          "label": "Durchschnittstemperatur – Optional",
          "sm": 12,
          "md": 12,
          "lg": 12,
          "help": "Nur bei manueller Wetterquelle. Erwartete Einheit: °C.",
          "hidden": "!data.forecastEnabled || data.weatherSourceMode !== 'manual'"
        },
        "weatherTempMaxState": {
