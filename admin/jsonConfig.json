    "priority": {
      "type": "panel",
      "label": "Priorities & regulation",
      "items": {
        "_h": {
          "type": "header",
          "text": "Priority concept",
          "size": 4,
          "sm": 12
        },
        "_i1": {
          "type": "staticText",
          "text": "Lower values mean higher priority. Device-specific priorities are configured in each device section. Normal heating demand is not blocked by Energy Pilot; only flexible PV-boost functions are prioritized.",
          "sm": 12
        },
        "allocationStrategy": {
          "type": "select",
          "label": "Allocation strategy",
          "options": [
            {
              "label": "Strict priority",
              "value": "priority"
            },
            {
              "label": "Minimum demand first",
              "value": "minimum"
            }
